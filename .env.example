# Machine-specific paths for tools/build_and_deploy.py.
# Copy this file to .env (not committed) and fill in your own paths.

# Visual Studio's x64 build environment script
VCVARS_BAT=C:\Program Files\Microsoft Visual Studio\<version>\Community\VC\Auxiliary\Build\vcvars64.bat

# Skyrim Special Edition install folder (has "Papyrus Compiler" and Data\Source\Scripts)
SKYRIM_DIR=C:\path\to\Skyrim Special Edition

# Papyrus import folders after the repo's own scripts, separated by ;
# Order matters: SKSE's script sources must come before the game's, so SKSE's versions win.
PAPYRUS_IMPORTS=C:\path\to\SKSE\Scripts\Source;C:\path\to\Skyrim Special Edition\Data\Source\Scripts;C:\path\to\SkyUI_SDK\Source\Scripts

# Mod folders to deploy the built mod into, separated by ; (e.g. a Mod Organizer 2 mod folder).
# Leave empty to build without deploying.
DEPLOY_TARGETS=C:\path\to\ModOrganizer\mods\In Their Shoes
